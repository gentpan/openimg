# Dependencies
/frontend/node_modules/

# Build output
/frontend/dist/
/apple/OpenimgKit/.build/
/apple/build/
/apple/**/*.xcodeproj
/apple/**/xcuserdata/
backend/picbi-server
backend/openimg-server

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.mobileprovision

# Local storage / uploads
# Anchored: an unanchored 'storage/' also swallows backend/internal/storage/,
# which is source. That has bitten a deploy rsync already.
/backend/storage/
/backend/tmp/
/storage/
/tmp/

# OS
.DS_Store

# Server backups / dumps — large binaries, not source
server-backup-*/
*.tgz
*.dump

# Logs
*.log
logs/

# Local secrets — never committed
/deploy/.env.local
