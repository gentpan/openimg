# openimg.io backend — copy to .env and fill in values.
# Only DATABASE_URL and JWT_SECRET are required to boot.

# --- Core ---
LISTEN_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://openimg@127.0.0.1:5432/openimg?sslmode=disable
PUBLIC_BASE_URL=http://127.0.0.1:8080

# GORM schema sync at startup. Leave on while models churn; production with a
# stable schema can set false to skip the per-table scans on every restart.
DB_AUTO_MIGRATE=true

# net/http/pprof on a separate listener, off unless set. No auth on it —
# bind loopback only (e.g. 127.0.0.1:6060).
PPROF_ADDR=

# 短链挂的域名。留空即与 PUBLIC_BASE_URL 同域(openimg.io/G4zx)。
# 短链的价值在于短,值得为它用一个更短的域名;但自建部署多半只有一个域名,
# 所以这一项是可选的,不配就是原来的行为。
SHORT_BASE_URL=
COOKIE_DOMAIN=
COOKIE_SECURE=false

# STORAGE_DIR is the local fallback used only when no platform bucket is
# configured (development). TEMP_DIR holds transient working files during
# transcoding — put it on the SSD, not the spinning array.
# Serve the built frontend from this process. Setting it is what lets short
# links live at the domain root (openimg.io/aB3d) as a real HTTP redirect —
# otherwise the reverse proxy has to decide which short paths are codes and
# which are pages, using a list that must stay in sync with the Go source.
# Point it at the frontend's dist/.
FRONTEND_DIR=

STORAGE_DIR=./storage
TEMP_DIR=./tmp

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Require a verified email before a user may upload. The single most effective
# anti-abuse switch on a free host; leave it on.
REQUIRE_EMAIL_VERIFIED=true

# --- Encryption ---
# AES-256 key (base64, 32 bytes) protecting user-supplied bucket credentials.
# Generate with: openssl rand -base64 32
# Losing this makes every stored credential unrecoverable — back it up
# separately from the database, and never commit it.
STORAGE_MASTER_KEY=

# --- Platform storage pool (MinIO) ---
# These bootstrap the platform StorageProfile row on first boot only. After
# that the database row is authoritative and changes here are ignored.
# S3_PATH_STYLE must be true for MinIO, false for Cloudflare R2.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=https://cdn.openimg.io
S3_KEY_PREFIX=
S3_PATH_STYLE=true

# --- Upload pipeline ---
# Server-wide ceiling; each user group's max_file_size applies below this.
MAX_UPLOAD_SIZE=52428800
# Background workers for AVIF transcoding and backup replication.
WORKER_COUNT=4
# libvips threads per operation. Total CPU load is roughly
# WORKER_COUNT * VIPS_CONCURRENCY, so keep the product at or under your cores.
VIPS_CONCURRENCY=2

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- pic.bi 关联 ---
# 两套凭据,用途不同,不要合并:
#   OAuth 那对是"让用户把两个账号连起来",走浏览器重定向、有同意页;
#   partner 那对是服务端到服务端的 HMAC 共享密钥,用来查余额和扣费。
# 任何一组留空,对应的能力就整个关掉。只配 OAuth 的话用户能关联却扣不了费,
# 4K 档也会一并关闭(见 allowedResolutionsFor)。
# 回调地址填 <PUBLIC_BASE_URL>/auth/picbi/callback,必须与 pic.bi 那边登记的
# 全串一致——那边是精确相等比较,差一个斜杠就 400。
PICBI_BASE_URL=
PICBI_CLIENT_ID=
PICBI_CLIENT_SECRET=
PICBI_PARTNER_ID=
PICBI_PARTNER_SECRET=

# --- Email ---
# Provider: cloudflare | sendflare | none. Leave empty to auto-pick whichever
# has credentials (Cloudflare first). Without a working sender, email-verified
# signup and OTP login are unavailable.
EMAIL_PROVIDER=cloudflare
EMAIL_FROM=noreply@openimg.io

# Cloudflare Email Sending. The sending domain must be verified in the
# Cloudflare dashboard, and the API token needs the "Email Sending" permission
# scoped to this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Sendflare (alternative)
SENDFLARE_API_KEY=

# --- Bootstrap admin (optional, first run only) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
