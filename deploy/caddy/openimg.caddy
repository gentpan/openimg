# openimg.io — kept in its own file so that redeploying toimg, whose Caddyfile
# is generated from its own repository, cannot silently drop these blocks.
#
# Managed from the openimg repo: deploy/caddy/openimg.caddy

# Own proxy snippet rather than reusing toimg's: sharing it would mean a change
# on their side silently altering how this site reaches storage.
#
# The Host header must match MINIO_SERVER_URL, which is how MinIO decides to
# parse the path as bucket/key instead of treating the hostname as the bucket.
(openimg_minio) {
	reverse_proxy 127.0.0.1:9000 {
		header_up Host s3-fsn1-dc5.toimg.com
		header_up X-Real-IP {remote_host}
		transport http {
			versions 1.1
			dial_timeout 300s
		}
	}
}

(openimg_object_headers) {
	# Object keys are write-once and never reused, so a year is safe.
	header Cache-Control "public, max-age=31536000, immutable"
	# Stored bytes are returned verbatim in original-upload mode, so a polyglot
	# file could still be valid HTML. This is what stops it executing.
	header X-Content-Type-Options nosniff
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
	@opts method OPTIONS
	respond @opts 204
}

www.openimg.io {
	tls /etc/caddy/certs/openimg-origin.crt /etc/caddy/certs/openimg-origin.key
	redir https://openimg.io{uri} permanent
}

openimg.io {
	tls /etc/caddy/certs/openimg-origin.crt /etc/caddy/certs/openimg-origin.key

	# The app streams uploads; a proxy-level cap would reject them before the
	# per-tier limit in the application ever applied.
	request_body {
		max_size 0
	}

	encode zstd gzip

	# CF-Connecting-IP is how the Go server learns the visitor's real address —
	# Caddy overwrites X-Forwarded-For with its own peer (a Cloudflare edge),
	# which had every per-IP feature keying on Cloudflare's addresses: the
	# upload rate limit was one bucket shared by everyone on the same edge.
	#
	# The header is only trustworthy when the request actually came from
	# Cloudflare, so strip it from every other source — anyone reaching the
	# origin directly could otherwise impersonate any address. gin's
	# TrustedPlatform on the Go side relies on this strip; the two configs are
	# a pair, do not change one without the other.
	#
	# Ranges from https://www.cloudflare.com/ips/ (stable for years).
	@not_cloudflare {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	request_header @not_cloudflare -CF-Connecting-IP

	reverse_proxy 127.0.0.1:8090 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			dial_timeout 10s
			response_header_timeout 300s
		}
	}
}

# Images, served straight from MinIO — the app hands out URLs on this host but
# never proxies the bytes itself.
cdn.imgla.com {
	tls /etc/caddy/certs/imgla-origin.crt /etc/caddy/certs/imgla-origin.key
	request_body {
		max_size 0
	}
	rewrite * /openimg{uri}
	import openimg_minio
	import openimg_object_headers
	header Content-Security-Policy "default-src 'none'; sandbox"
}

# Thumbnails. Same bucket — the split is at the hostname, not the storage:
# every object is written by one pipeline into one bucket, and a second bucket
# would only add a place for them to disagree. What the separate origin buys is
# CDN-level control: the thumbnail tier can be purged or re-tuned without
# touching originals, and thumbnails are regenerable so that purge is cheap.
cache.imgla.com {
	tls /etc/caddy/certs/imgla-origin.crt /etc/caddy/certs/imgla-origin.key
	rewrite * /openimg{uri}
	import openimg_minio
	import openimg_object_headers
}
